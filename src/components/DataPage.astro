---
import Layout from '../components/Layout.astro'
import CorpusTable from '../components/CorpusTable.astro'
import { messages, type Locale } from '../i18n'
import { type ColumnDef, type Row } from '../lib/corpus'

interface Props {
  locale: Locale
  path: string
  title: string
  description: string
  eyebrow: string
  rows: Row[]
  columns: ColumnDef[]
  variant?: 'all' | 'lean'
}
const { locale, path, title, description, eyebrow, rows, columns, variant = 'all', ds } = Astro.props
const t = messages[locale]
const ui = (t as Record<string, any>).ui as Record<string, string>
const tableId = "tbl-" + locale + "-" + path.replace(/[^a-z0-9]/gi, "")
const visibleCount = columns.filter((c) => c.visible).length
---
<Layout
  locale={locale}
  path={path}
  title={title + " \u00b7 " + t.app.title}
  description={description}
  shell
>
  <div class="page-head">
    <div class="eyebrow">{eyebrow} · Lagarrue 1900</div>
    <h1>{title}</h1>
    <div class="meta-line">
      <span><b>{rows.length.toLocaleString()}</b> {ui.entries}</span>
      <span><b>{visibleCount}</b> / {columns.length} {ui.cols}</span>
    </div>
  </div>
  <CorpusTable rows={rows} columns={columns} locale={locale} variant={variant} tableId={tableId} ds={ds} />
</Layout>
